# OpenAI Compatible API settings

OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com
OPENAI_COMPATIBLE_MODEL=
USE_LOCAL_MODEL=api # 让总结 Agent 使用 API，不加载本地 FinR1 模型。

# ReAct Agent 最大图递归步数，默认40，允许范围10-64
REACT_RECURSION_LIMIT=40
AGENT_TIMEOUT_SECONDS=600
MCP_CACHE_ENABLED=1
MCP_CACHE_TTL_SECONDS=300

# Web platform
WEB_DATABASE_PATH=web/backend/data/research_web.db
WEB_LOG_DIR=logs
WEB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEB_TIMEZONE=Asia/Shanghai
INTENT_ROUTER_USE_LLM=1
DIRECT_TOOL_ROUTING_ENABLED=1
